{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/shapes/config.json",
  "packages": {
    ".": {
      "package-name": "plane-orca",
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "changelog-sections": [
        { "type": "feat", "section": "✨ Features", "hidden": false },
        { "type": "fix", "section": "🐛 Bug Fixes", "hidden": false },
        { "type": "style", "section": "🎨 Styles & UI", "hidden": false },
        { "type": "docs", "section": "📝 Documentation", "hidden": false },
        { "type": "refactor", "section": "♻️ Refactoring", "hidden": false },
        { "type": "perf", "section": "⚡ Performance", "hidden": false },
        { "type": "chore", "section": "🔧 Chores & Maintenance", "hidden": false },
        { "type": "test", "section": "🧪 Tests", "hidden": false },
        { "type": "ci", "section": "⚙️ Continuous Integration", "hidden": false },
        { "type": "build", "section": "📦 Build System & Dependencies", "hidden": false }
      ],
      "extra-files": []
    }
  }
}
